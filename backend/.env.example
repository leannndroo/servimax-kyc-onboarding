# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Orígenes web permitidos (separados por coma). La app móvil no necesita CORS.
CORS_ORIGINS=

# ─── OCR ─────────────────────────────────────────────────────
# Interruptor global del OCR (true/false). En false la app pasa a digitación manual.
OCR_ENABLED=true
# ocrspace = OCR real (https://ocr.space/ocrapi/freekey) · mock = OCR simulado
OCR_PROVIDER=ocrspace
# Tu API key gratuita de OCR.space. Si queda vacía, se usa el OCR simulado.
OCR_SPACE_API_KEY=
OCR_SPACE_URL=https://api.ocr.space/parse/image
OCR_TIMEOUT_MS=20000

# ─── Proveedor KYC ───────────────────────────────────────────
# Por defecto apunta al mock HTTP documentado que corre en este mismo servidor.
# Para un proveedor real (ej. Usecroma) cambia la URL y la key.
KYC_BASE_URL=http://127.0.0.1:3000/mock-kyc/v1
KYC_API_KEY=cambia-esta-clave-del-mock
KYC_TIMEOUT_MS=4000
KYC_MAX_RETRIES=1

# ─── Datos y retención ───────────────────────────────────────
DATA_FILE=data/sessions.json
# Horas que se conserva una sesión antes de purgarla
SESSION_TTL_HOURS=72
# Minutos máximos que una foto vive en memoria (nunca se guarda en disco)
IMAGE_TTL_MINUTES=30
MAX_IMAGE_MB=5
