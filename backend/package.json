{
  "name": "servimax-kyc-backend",
  "version": "1.0.0",
  "description": "Backend de orquestación para el onboarding KYC de tenderos (registro, OCR, consultas, score y auditoría).",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/cedulaParser.test.ts tests/scoring.test.ts tests/kycClient.test.ts tests/api.test.ts",
    "test:unit": "tsx --test tests/cedulaParser.test.ts tests/scoring.test.ts tests/kycClient.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.2",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
